-- ===== ESP =====
local ESPObj = {}
local function limparESP()
    for _, o in pairs(ESPObj) do
        for _, v in pairs(o) do
            if v then
                pcall(function() if v.Remove then v:Remove() end end)
                pcall(function() if v.Destroy then v:Destroy() end end)
            end
        end
    end
    ESPObj = {}
end

local function updateESP()
    if not CFG.ESP then
        if next(ESPObj) then limparESP() end
        return
    end
    local meuHRP = getHRP()
    local minhaPos = meuHRP and meuHRP.Position or Vector3.zero
    local validos = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - minhaPos).Magnitude
                if dist <= 1500 then
                    validos[p] = true
                    local cor = Color3.fromRGB(255,60,60)
                    if not ESPObj[p] then
                        local o = {}
                        if CFG.Box then o.Box = Drawing.new("Square") o.Box.Thickness=1 o.Box.Filled=false o.Box.Visible=false o.Box.ZIndex=2 end
                        if CFG.Line then o.Line = Drawing.new("Line") o.Line.Thickness=1.5 o.Line.Visible=false o.Line.ZIndex=2 end
                        if CFG.Nome then o.Nome = Drawing.new("Text") o.Nome.Size=13 o.Nome.Center=true o.Nome.Outline=true o.Nome.OutlineColor=Color3.new(0,0,0) o.Nome.Visible=false o.Nome.ZIndex=3 end
                        if CFG.Dist then o.Dist = Drawing.new("Text") o.Dist.Size=11 o.Dist.Center=true o.Dist.Outline=true o.Dist.OutlineColor=Color3.new(0,0,0) o.Dist.Visible=false o.Dist.ZIndex=3 end
                        if CFG.Chams then
                            o.HL = Instance.new("Highlight")
                            o.HL.OutlineColor = Color3.new(1,1,1)
                            o.HL.FillTransparency = 0.5
                            o.HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            o.HL.Enabled = false
                            o.HL.Parent = p.Character
                        end
                        ESPObj[p] = o
                    end
                    local o = ESPObj[p]
                    if o.HL then
                        if o.HL.Parent ~= p.Character then o.HL.Parent = p.Character end
                        o.HL.FillColor = cor
                        o.HL.Enabled = true
                    end
                    local topo2d, topoOn = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0,3,0))
                    local base2d, baseOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
                    if topoOn and baseOn and topo2d.Z > 0 and base2d.Z > 0 then
                        if o.Box then
                            local h = math.abs(base2d.Y - topo2d.Y)
                            local w = h * 0.6
                            o.Box.Size = Vector2.new(w, h)
                            o.Box.Position = Vector2.new(topo2d.X - w/2, topo2d.Y)
                            o.Box.Color = cor
                            o.Box.Visible = true
                        end
                        if o.Line then
                            local pe2d, peOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,2.5,0))
                            local ch2d, chOn = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,8,0))
                            if peOn and chOn then
                                o.Line.From = Vector2.new(pe2d.X, pe2d.Y)
                                o.Line.To = Vector2.new(ch2d.X, ch2d.Y)
                                o.Line.Color = cor
                                o.Line.Visible = true
                            else o.Line.Visible = false end
                        end
                        if o.Nome then
                            o.Nome.Text = p.Name
                            o.Nome.Position = Vector2.new(topo2d.X, topo2d.Y)
                            o.Nome.Color = cor
                            o.Nome.Visible = true
                        end
                        if o.Dist then
                            o.Dist.Text = "["..math.floor(dist).."m]"
                            o.Dist.Position = Vector2.new(topo2d.X, topo2d.Y + 14)
                            o.Dist.Color = cor
                            o.Dist.Visible = true
                        end
                    else
                        if o.Box then o.Box.Visible = false end
                        if o.Line then o.Line.Visible = false end
                        if o.Nome then o.Nome.Visible = false end
                        if o.Dist then o.Dist.Visible = false end
                    end
                end
            end
        end
    end
    for p, o in pairs(ESPObj) do
        if not validos[p] then
            for _, v in pairs(o) do
                if v then
                    pcall(function() if v.Remove then v:Remove() end end)
                    pcall(function() if v.Destroy then v:Destroy() end end)
                end
            end
            ESPObj[p] = nil
        end
    end
end

-- ===== HITBOX =====
local hitboxOrig = {}
local function updateHitbox()
    if not CFG.Hitbox then
        for hrp, t in pairs(hitboxOrig) do
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.Size = t.size hrp.Transparency = t.trans
                    hrp.CanCollide = t.collide hrp.Massless = t.massless
                end)
            end
        end
        hitboxOrig = {}
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not hitboxOrig[hrp] then
                    hitboxOrig[hrp] = {size=hrp.Size, trans=hrp.Transparency, collide=hrp.CanCollide, massless=hrp.Massless}
                end
                local nt = Vector3.new(CFG.HitboxTam, CFG.HitboxTam, CFG.HitboxTam)
                if hrp.Size ~= nt then hrp.Size = nt end
                if hrp.Transparency ~= 1 then hrp.Transparency = 1 end
                if hrp.CanCollide then hrp.CanCollide = false end
                if not hrp.Massless then hrp.Massless = true end
            end
        end
    end
end

-- ===== NOCLIP (NOVO) =====
local function updateNoclip()
    if not CFG.Noclip then return end
    local char = LP.Character
    if not char then return end
    for _, pt in ipairs(char:GetDescendants()) do
        if pt:IsA("BasePart") and pt.CanCollide then
            pt.CanCollide = false
        end
    end
end

